# CourseForge AI configuration template.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored; never commit it.
# If no API key is set, the app runs in a clearly labeled deterministic demo mode (no AI used).

# LLM provider. Currently planned: "anthropic". Leave empty to force demo mode.
LLM_PROVIDER=anthropic

# Provider API key (keep secret).
ANTHROPIC_API_KEY=

# Model identifier sent to the provider API. Must be a model your account can access;
# the app checks it with the provider before generating anything.
COURSEFORGE_MODEL=

# Optional: effort level (low, medium, high, xhigh, max) for models that support it.
# Leave empty to use the model's default.
COURSEFORGE_EFFORT=
