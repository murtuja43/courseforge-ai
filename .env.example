# CourseForge AI configuration template.
# Copy this file to `.env` and fill in your key. `.env` is git-ignored; never commit it.
# Without a key, AI generation is unavailable; Demo mode (offline, no AI) still works.

# AI provider. Only "gemini" (Google Gemini API free tier) is supported.
# Leave empty to turn AI generation off.
LLM_PROVIDER=gemini

# Gemini API key from Google AI Studio (keep secret).
# Create it in a Google Cloud project WITHOUT billing so it stays on the free tier.
GEMINI_API_KEY=

# Optional. Approved free-tier model; leave empty for the default (gemini-3.8-flash).
COURSEFORGE_MODEL=
